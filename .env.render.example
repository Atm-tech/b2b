NODE_ENV=production
OPENAI_API_KEY=
ASSISTANT_USE_OPENAI=false
LOCAL_WHISPER_ENABLED=false
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
PORT=8080
DATABASE_URL=<render-postgres-connection-string>
UPLOADS_DIR=/var/data/uploads
ALLOWED_ORIGINS=https://your-frontend.onrender.com
REQUEST_BODY_LIMIT=2mb
MAX_UPLOAD_BYTES=8388608
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=aapoorti-proofs
R2_OBJECT_PREFIX=proofs
VITE_API_BASE_URL=https://your-api.onrender.com
PUBLIC_API_URL=https://your-api.onrender.com
PUBLIC_WEB_URL=https://your-frontend.vercel.app
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=<meta-system-user-token>
WHATSAPP_PHONE_NUMBER_ID=<meta-phone-number-id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<meta-whatsapp-business-account-id>
WHATSAPP_CATALOG_ID=<meta-commerce-catalog-id>
WHATSAPP_VERIFY_TOKEN=<random-webhook-verification-token>
WHATSAPP_APP_SECRET=<meta-app-secret>
WHATSAPP_CATALOG_FEED_TOKEN=<random-catalog-feed-token>
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OFFER_TEMPLATE=<approved-special-offer-template-name>
WHATSAPP_SALESPERSON_ALERT_TEMPLATE=<optional-approved-staff-alert-template-name>
WHATSAPP_PILOT_USERNAMES=wa.sales
