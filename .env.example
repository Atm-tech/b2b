NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://aapoorti_app:aapoorti123@127.0.0.1:5432/aapoorti_b2b
UPLOADS_DIR=uploads
ALLOWED_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=2mb
MAX_UPLOAD_BYTES=8388608
# Leave the R2 values blank to use local filesystem storage during development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aapoorti-proofs
R2_OBJECT_PREFIX=proofs
VITE_API_BASE_URL=http://localhost:8080
OPENAI_API_KEY=
ASSISTANT_USE_OPENAI=false
LOCAL_WHISPER_ENABLED=true
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_THREADS=6
LOCAL_WHISPER_TIMEOUT_MS=240000
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:5173
# Meta WhatsApp Cloud API. Leave access token/phone ID blank for safe simulation mode.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CATALOG_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-random-webhook-token
WHATSAPP_APP_SECRET=
WHATSAPP_CATALOG_FEED_TOKEN=replace-with-random-feed-token
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OFFER_TEMPLATE=
WHATSAPP_SALESPERSON_ALERT_TEMPLATE=
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=aapoorti_b2b
POSTGRES_USER=aapoorti_app
POSTGRES_PASSWORD=aapoorti123
POSTGRES_PORT=5432
